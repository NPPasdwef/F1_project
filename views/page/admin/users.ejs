                <th>ชื่อผู้ใช้</th>
                <th>ชื่อ</th>
                <th>บทบาท</th>
                <th>เข้าใช้งานล่าสุด</th>
                <th>สถานะ</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>admin</td>
                <td>ผู้ดูแลร้าน</td>
                <td>
                  <span class="badge text-bg-dark">admin</span>
                </td>
                <td>05/05/2026 18:10</td>
                <td>
                  <span class="badge text-bg-success">ใช้งาน</span>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary">แก้ไข</button>
                </td>
              </tr>
              <tr>
                <td>staff01</td>
                <td>พนักงานหน้าร้าน</td>
                <td>
                  <span class="badge text-bg-primary">staff</span>
                </td>
                <td>05/05/2026 18:00</td>
                <td>
                  <span class="badge text-bg-success">ใช้งาน</span>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary">แก้ไข</button>
                </td>
              </tr>
              <tr>
                <td>kitchen01</td>
                <td>ครัวกลาง</td>
                <td>
                  <span class="badge text-bg-warning">kitchen</span>
                </td>
                <td>05/05/2026 17:55</td>
                <td>
                  <span class="badge text-bg-success">ใช้งาน</span>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary">แก้ไข</button>
                </td>
              </tr>
              <tr>
                <td>cashier01</td>
                <td>แคชเชียร์</td>
                <td>
                  <span class="badge text-bg-info">cashier</span>
                </td>
                <td>05/05/2026 17:50</td>
                <td>
                  <span class="badge text-bg-success">ใช้งาน</span>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary">แก้ไข</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>