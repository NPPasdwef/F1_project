<main class="container-fluid py-4">
  <h1 class="h3 mb-4">จัดการผู้ใช้และบทบาท</h1>
  <div class="row g-4">
    <div class="col-12 col-xl-4">
      <div class="card">
        <div class="card-header bg-white fw-semibold">เพิ่มผู้ใช้</div>
        <div class="card-body">
          <form action="#" method="post">
            <div class="mb-3">
              <label class="form-label" for="username">ชื่อผู้ใช้</label>
              <input class="form-control" id="username" placeholder="เช่น staff04">
            </div>
            <div class="mb-3">
              <label class="form-label" for="fullName">ชื่อจริง</label>
              <input class="form-control" id="fullName" placeholder="ชื่อ-นามสกุล">
            </div>
            <div class="mb-3">
              <label class="form-label" for="role">บทบาท</label>
              <select class="form-select" id="role">
                <option>staff</option>
                <option>kitchen</option>
                <option>cashier</option>
                <option>manager</option>
                <option>admin</option>
              </select>
            </div>
            <div class="mb-4">
              <label class="form-label" for="status">สถานะ</label>
              <select class="form-select" id="status">
                <option>ใช้งาน</option>
                <option>ปิดใช้งาน</option>
              </select>
            </div>
            <button class="btn btn-primary w-100" type="submit">บันทึกผู้ใช้</button>
          </form>
        </div>
      </div>
    </div>
    <div class="col-12 col-xl-8">
      <div class="card">
        <div class="card-header bg-white fw-semibold">รายการผู้ใช้</div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
