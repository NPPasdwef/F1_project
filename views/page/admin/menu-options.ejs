<main class="container-fluid py-4">
  <h1 class="h3 mb-4">จัดการตัวเลือกเพิ่มเติมของเมนู</h1>
  <div class="row g-4">
    <div class="col-12 col-lg-4">
      <div class="card">
        <div class="card-header bg-white fw-semibold">เพิ่มชุดตัวเลือก</div>
        <div class="card-body">
          <form action="#" method="post">
            <div class="mb-3">
              <label class="form-label" for="optionName">ชื่อตัวเลือก</label>
              <input class="form-control" id="optionName" value="ระดับความเผ็ด">
            </div>
            <div class="row g-3">
              <div class="col-6">
                <label class="form-label" for="min">เลือกขั้นต่ำ</label>
                <input class="form-control" type="number" id="min" value="1">
              </div>
              <div class="col-6">
                <label class="form-label" for="max">เลือกสูงสุด</label>
                <input class="form-control" type="number" id="max" value="1">
              </div>
            </div>
            <div class="mt-3">
              <label class="form-label" for="values">ค่าตัวเลือก</label>
              <textarea class="form-control" id="values" rows="4">
เผ็ดน้อย +0
เผ็ดกลาง +0
เผ็ดมาก +0</textarea>
            </div>
            <button class="btn btn-primary w-100 mt-4" type="submit">บันทึกตัวเลือก</button>
          </form>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-8">
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>ตัวเลือก</th>
                <th>ค่า</th>
                <th>ราคาเพิ่ม</th>
                <th>บังคับเลือก</th>
                <th>สถานะ</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>ระดับความเผ็ด</td>
                <td>เผ็ดน้อย, เผ็ดกลาง, เผ็ดมาก</td>
                <td>0</td>
                <td>ใช่</td>
                <td>
                  <span class="badge text-bg-success">ใช้งาน</span>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary">แก้ไข</button>
                </td>
              </tr>
              <tr>
                <td>ขนาด</td>
                <td>ปกติ, พิเศษ</td>
                <td>0-15</td>
                <td>ใช่</td>
                <td>
                  <span class="badge text-bg-success">ใช้งาน</span>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary">แก้ไข</button>
                </td>
              </tr>
              <tr>
                <td>ท็อปปิง</td>
                <td>ไข่ดาว, เพิ่มข้าว</td>
                <td>10</td>
                <td>ไม่</td>
                <td>
                  <span class="badge text-bg-success">ใช้งาน</span>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary">แก้ไข</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>